{
    "name": "djo/vite-et-gourmand",
    "description": "Easy to Write, Hard to Master",
    "type": "project",
    "license": "proprietary",
    "require": {
        "phpmailer/phpmailer": "^7.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mongodb": "*",
        "ext-bcmath": "*",
        "ext-zip": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "Controllers\\": "src/Controllers/",
            "Entities\\": "src/Entities/",
            "Interfaces\\": "src/Interfaces/",
            "Repositories\\": "src/Repositories/",
            "Services\\": "src/Services/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    }
}
